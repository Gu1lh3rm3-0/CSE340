<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <a href="/new-category" class="category-action">
        Add New Category
    </a>

    <% categories.forEach(category => { %>

        <div class="category-item">
            <a href="/category/<%= category.category_id %>">
                <%= category.name %>
            </a>
        </div>

    <% }); %>
</main>

<%- include('partials/footer') %>