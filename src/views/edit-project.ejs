<%- include('partials/header', { title: title }) %>

<main>
    <h1>Edit Service Project</h1>

    <form action="/edit-project/<%= projectDetails.project_id %>" method="POST">

        <label for="title">Project Title</label>
        <input
            type="text"
            id="title"
            name="title"
            value="<%= projectDetails.title %>"
            required
        >

        <label for="description">Description</label>
        <textarea
            id="description"
            name="description"
            required
        ><%= projectDetails.description %></textarea>

        <label for="location">Location</label>
        <input
            type="text"
            id="location"
            name="location"
            value="<%= projectDetails.location %>"
            required
        >

        <label for="project_date">Project Date</label>
        <input
            type="date"
            id="project_date"
            name="project_date"
            value="<%= projectDetails.project_date.toISOString().split('T')[0] %>"
            required
        >

        <label for="organization_id">Organization</label>
        <select
            id="organization_id"
            name="organization_id"
            required
        >
            <% organizations.forEach(organization => { %>
                <option
                    value="<%= organization.organization_id %>"
                    <%= organization.organization_id == projectDetails.organization_id ? 'selected' : '' %>
                >
                    <%= organization.name %>
                </option>
            <% }); %>
        </select>

        <button type="submit">Update Project</button>

        <a href="/project/<%= projectDetails.project_id %>">
            Cancel
        </a>

    </form>
</main>

<%- include('partials/footer') %>