<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <h1><%= projectDate %></h1>
    <form action="/edit-project/<%= projectId %>" method="POST">
    
        <div class='form-group'>
            <label for='title'>Title: </label>
            <input
            type="text"
            name="title"
            id="title"
            maxlength="100"
            required
            value="<%=projectDetails.title%>"
            />
        </div>
        <div class='form-group'>
            <label for="description">Description: </label>

            <textarea
            id="description"
            name="description"
            maxlength="1000"
            required
            ><%=projectDetails.description%></textarea>
        </div>
        <div class='form-group'>
            <label for="location">Location: </label>
            <input
        type="text"
        id="location"
        name="location"
        required
        minlength="10"
        maxlength="200"
        value="<%=projectDetails.location%>"
      />
        </div>
        <div class='form-group'>
            <label for="date">Date: </label>
        
            <input
            type="date"
            name="date"
            id="date"
            required
            value= "<%= projectDate %>"
            />
        </div>
        <div class='form-group'>
            <label for="organization_id">Organization</label>
            <select id="organization_id" name="organization_id" value=value = <%=projectDetails.organization_id%> required>
                <%Object.entries(organizations).forEach(([key, value]) =>{%>
                    <option value="<%=value.organization_id%>"><%=value.organization_name%></option>
                <%});%>
            </select>
        </div>

        <button type='submit'>Save Project</button>
    </form>

</main>
<%- include('partials/footer') %>